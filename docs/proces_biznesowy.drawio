        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;flowchart LR\n    %% Style wizualne zgodne z BPMN 2.0\n    classDef startEvent fill:#e8f5e9,stroke:#2e7d32,stroke-width:2px,color:#000\n    classDef taskNode fill:#e3f2fd,stroke:#1565c0,stroke-width:1.5px,color:#000\n    classDef exceptionTask fill:#fff3e0,stroke:#ef6c00,stroke-width:1.5px,color:#000\n    classDef gatewayNode fill:#fff9c4,stroke:#f9a825,stroke-width:2px,color:#000\n    classDef endSuccess fill:#c8e6c9,stroke:#1b5e20,stroke-width:4px,color:#000\n    classDef endError fill:#ffcdd2,stroke:#c62828,stroke-width:4px,color:#000\n\n    subgraph Lider[\&quot;Lider Projektu\&quot;]\n        Start((\&quot;Start:&lt;br/&gt;Potrzeba zadania\&quot;)) --&gt; T1(\&quot;Utworzenie zadania (To Do)&lt;br/&gt;i przypisanie wykonawcy\&quot;)\n        T4(\&quot;Analiza blokady i ocena&lt;br/&gt;wykonalności zadania\&quot;) --&gt; G3{\&quot;X&lt;br/&gt;Czy zadanie jest&lt;br/&gt;jednak wykonalne?\&quot;}\n        G3 -- \&quot;Tak (Wznowienie)\&quot; --&gt; T9(\&quot;Odblokowanie zadania&lt;br/&gt;(powrót do In Progress)\&quot;)\n        G3 -- \&quot;Nie (Brak możliwości)\&quot; --&gt; T10(\&quot;Anulowanie zadania\&quot;)\n        T10 --&gt; End2((\&quot;Koniec wyjątkowy:&lt;br/&gt;Zadanie przerwane\&quot;))\n        T5(\&quot;Weryfikacja wykonanego&lt;br/&gt;zadania\&quot;) --&gt; G2{\&quot;X&lt;br/&gt;Czy zadanie spełnia&lt;br/&gt;wymagania?\&quot;}\n        G2 -- \&quot;Tak\&quot; --&gt; T6(\&quot;Zatwierdzenie zadania&lt;br/&gt;(status: Done)\&quot;)\n        T6 --&gt; End1((\&quot;Koniec:&lt;br/&gt;Zadanie zakończone\&quot;))\n    end\n\n    subgraph Czlonek[\&quot;Członek Koła\&quot;]\n        T1 --&gt; T2(\&quot;Podjęcie zadania&lt;br/&gt;(status: In Progress)\&quot;)\n        T2 --&gt; G1{\&quot;X&lt;br/&gt;Czy wystąpił problem /&lt;br/&gt;brak zasobów?\&quot;}\n        G1 -- \&quot;Tak (Wyjątek)\&quot; --&gt; T3(\&quot;Zmiana statusu na Blocked&lt;br/&gt;i opisanie problemu\&quot;)\n        T3 --&gt; T4\n        G1 -- \&quot;Nie\&quot; --&gt; T7(\&quot;Realizacja zadania\&quot;)\n        T9 --&gt; T7\n        G2 -- \&quot;Nie (Cofnięcie do poprawy)\&quot; --&gt; T7\n        T7 --&gt; T8(\&quot;Zgłoszenie do weryfikacji&lt;br/&gt;(status: Review)\&quot;)\n        T8 --&gt; T5\n    end\n\n    subgraph Legenda[\&quot;LEGENDA (Notacja BPMN)\&quot;]\n        L1((\&quot;Zdarzenie początkowe&lt;br/&gt;(Start)\&quot;))\n        L2(\&quot;Zadanie / Czynność&lt;br/&gt;(Task)\&quot;)\n        L2b(\&quot;Obsługa wyjątku&lt;br/&gt;(Status Blocked)\&quot;)\n        L3{\&quot;X&lt;br/&gt;Bramka decyzyjna&lt;br/&gt;(XOR)\&quot;}\n        L4((\&quot;Zdarzenie końcowe&lt;br/&gt;(Sukces)\&quot;))\n        L5((\&quot;Zdarzenie końcowe&lt;br/&gt;(Wyjątek / Anulowanie)\&quot;))\n        L1 ~~~ L2 ~~~ L2b ~~~ L3 ~~~ L4 ~~~ L5\n    end\n\n    %% Przypisanie stylów do elementów\n    class Start,L1 startEvent\n    class T1,T2,T5,T6,T7,T8,T9,L2 taskNode\n    class T3,T4,T10,L2b exceptionTask\n    class G1,G2,G3,L3 gatewayNode\n    class End1,L4 endSuccess\n    class End2,L5 endError\n\n    style Lider fill:#ffffff,stroke:#424242,stroke-width:1.5px\n    style Czlonek fill:#ffffff,stroke:#424242,stroke-width:1.5px\n    style Legenda fill:#f8f9fa,stroke:#757575,stroke-dasharray: 5 5&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="5nGgraCR_G0mA3xbqnex-1">
